DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=odontologia_db
DB_PORT=3306

JWT_SECRET=cambiar_por_clave_secreta_segura
JWT_EXPIRES_IN=8h
CLIENT_URL=http://localhost:5173
PORT=4000
CLIENT_URLS=http://localhost:5173

# Almacenamiento privado. Cloudinary permanece activo por defecto.
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Alternativa futura: usar STORAGE_PROVIDER=r2 y completar estas variables.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Opcional; se construye automáticamente con R2_ACCOUNT_ID.
R2_ENDPOINT=

EXPEDIENTE_SIGNING_SECRET=

# Solo para el primer arranque de una instalación nueva. Eliminar después de crear el administrador.
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_NAME=
ADMIN_INITIAL_LASTNAME=
